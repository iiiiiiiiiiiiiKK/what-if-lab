# Copy to .env.local (never commit real values) or paste the values into your
# deployment platform's secret store.
#
# These are only needed for the OPTIONAL AI proxy (server/ai-proxy.mjs) or a
# serverless deployment of the same endpoint. The pure static build needs none.

# OpenAI-compatible endpoint, e.g. https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1

# Secret. Never expose this with a VITE_ prefix — Vite inlines those into the bundle.
AI_API_KEY=

# Model name used when the client does not send one
AI_MODEL=gpt-4o-mini

# Local proxy port
PORT=8787

# Restrict CORS to your deployed origin in production
ALLOWED_ORIGIN=*
